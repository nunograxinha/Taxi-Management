# MongoDB connection URI (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/psi

# Port where the Express server will run
PORT=3073

# Secret key for signing JWT tokens (override in production)
JWT_SECRET=change-this-jwt-secret-in-production

# Manager login password (override in production)
MANAGER_PASSWORD=admin123

# Comma-separated allowed CORS origins (or * for all origins)
CORS_ORIGIN=*
